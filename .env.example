# Copy to .env and adjust. Never commit .env.

# Postgres (inside Docker). The host port avoids clashing with a local Postgres on 5432.
POSTGRES_USER=lodestar
POSTGRES_PASSWORD=lodestar
POSTGRES_DB=lodestar
LODESTAR_PG_PORT=5442

LODESTAR_QDRANT_PORT=6333
# Qdrant Cloud instead of the local container (docs/DEPLOY.md): its URL and API key. Compose sets
# QDRANT_URL for the local one; the key stays empty locally.
QDRANT_API_KEY=
LODESTAR_API_PORT=8000
LODESTAR_WEB_PORT=5173

# Local LLM. Default: the Ollama already running on the host. Containers can only reach it if it
# listens on all interfaces (OLLAMA_HOST=0.0.0.0 for the host's ollama service); otherwise use
# `make up-ollama` and http://ollama:11434, or run the backend outside Docker.
OLLAMA_URL=http://host.docker.internal:11434
LODESTAR_LOCAL_MODEL=qwen3.5:4b

# Encrypts users' API keys at rest (AGENTS.md rule 9). Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
LODESTAR_MASTER_KEY=

# Optional: the server's own hosted model. It fills background jobs, and on a server without
# Ollama (Render) it writes the coach's replies for students who switched Cloud AI on.
# Leave empty to use Ollama, then templates.
LODESTAR_OPERATOR_LLM_PROVIDER=
LODESTAR_OPERATOR_LLM_KEY=
LODESTAR_OPERATOR_LLM_MODEL=
# Shorthand for Gemini OCR and hosted replies; students must enable Cloud AI.
# Explicit LODESTAR_OPERATOR_LLM_* settings take precedence.
GEMINI_API_KEY=

# The "Demo person" button lets anyone who can reach the API sign in as the demo user. Set to 0 on a public deployment.
LODESTAR_DEMO=1

# Who studies the built-in Probability 1 course: "demo" (Alex and the seeded classmates; everyone
# else works from the chapters they upload) or "all".
LODESTAR_BUILT_IN_COURSE=demo
